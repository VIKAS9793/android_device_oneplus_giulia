<resources>
    <!-- The radius of the enrollment progress bar, in dp -->
    <integer name="config_udfpsEnrollProgressBar">94</integer>

    <!-- The number of vibration intensity levels supported by the device.
         Note that settings app will not show these settings if this is not set. -->
    <integer name="config_vibration_supported_intensity_levels">3</integer>

    <!-- Whether to show a warning notification when device's skin temperature is high. -->
    <bool name="config_showTemperatureWarning">true</bool>

    <!-- Whether to show a alarm notification when device's battery temperature is high. -->
    <bool name="config_showBatteryTemperatureWarning">true</bool>

    <!-- Doze: does this device support STATE_DOZE?  -->
    <bool name="doze_display_state_supported">true</bool>

    <!-- Doze: does this device support STATE_DOZE_SUSPEND?  -->
    <bool name="doze_suspend_display_state_supported">true</bool>

    <!-- Max visible notification icons -->
    <integer name="config_maxVisibleNotificationIcons">6</integer>
    <integer name="config_maxVisibleNotificationIconsOnLock">7</integer>
</resources> 